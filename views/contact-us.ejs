<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, canonical, trackingId}) %>
<body>

<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<%- include('partials/header') %>

<!-- Page Hero -->
<section class="page-hero" style="padding-bottom:48px">
  <div class="dw-container">
    <div class="page-hero-content">
      <div class="breadcrumb-dw">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Contact</span>
      </div>
      <span class="section-label">Let&rsquo;s Build Together</span>
      <h1>Start a conversation.</h1>
      <p class="section-sub mx-auto">
        Tell us about your project and we&rsquo;ll come back with a plan.
        No commitment required.
      </p>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section class="contact-section dw-section">
  <div class="dw-container">
    <div class="contact-grid">

      <!-- Left: info -->
      <div class="contact-info">
        <span class="section-label">Get in Touch</span>
        <h2>We respond within<br>24 hours.</h2>
        <p class="section-sub" style="margin-bottom:36px">
          Whether you have a clear brief or a rough idea, send us a message.
          We&rsquo;ll help you figure out the right path forward.
        </p>

        <div class="contact-details">
          <div class="cdetail">
            <div class="cdetail-icon acc">&#9993;</div>
            <div>
              <span class="cdetail-lbl">Email Us</span>
              <p class="cdetail-val"><a href="mailto:contact@dadwordit.com">contact@dadwordit.com</a></p>
            </div>
          </div>
          <div class="cdetail">
            <div class="cdetail-icon">&#128205;</div>
            <div>
              <span class="cdetail-lbl">Office</span>
              <p class="cdetail-val">N-1007 North Building, Twinstar, 150 Feet Ring Road, Rajkot 360004, India</p>
            </div>
          </div>
          <div class="cdetail">
            <div class="cdetail-icon">&#9200;</div>
            <div>
              <span class="cdetail-lbl">Response Time</span>
              <p class="cdetail-val">Within 24 hours, Monday to Saturday</p>
            </div>
          </div>
          <div class="cdetail">
            <div class="cdetail-icon">&#128197;</div>
            <div>
              <span class="cdetail-lbl">Book a Call Instead</span>
              <p class="cdetail-val"><a href="/lets-talk" style="color:var(--accent);font-weight:600">Schedule a free 30-min strategy session &rarr;</a></p>
            </div>
          </div>
        </div>

        <!-- Mini trust signals -->
        <div style="margin-top:40px;padding:20px 24px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px">
          <p style="font-size:.78rem;color:var(--text-faint);font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px">What happens next</p>
          <div style="display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;gap:10px;align-items:flex-start">
              <span style="color:var(--accent-2);font-weight:700;font-size:.9rem;flex-shrink:0">01</span>
              <p style="font-size:.85rem;margin:0">We review your message and research your project.</p>
            </div>
            <div style="display:flex;gap:10px;align-items:flex-start">
              <span style="color:var(--accent-2);font-weight:700;font-size:.9rem;flex-shrink:0">02</span>
              <p style="font-size:.85rem;margin:0">We reply within 24 hours with initial thoughts or clarifying questions.</p>
            </div>
            <div style="display:flex;gap:10px;align-items:flex-start">
              <span style="color:var(--accent-2);font-weight:700;font-size:.9rem;flex-shrink:0">03</span>
              <p style="font-size:.85rem;margin:0">If there&rsquo;s a fit, we schedule a free discovery call.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <%- include('partials/form') %>

    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: recent_blogs }) %>
<script src="/js/dadword.js" defer></script>
</body>
</html>
