<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, trackingId}) %>
<body>

<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<%- include('partials/header') %>

<% if (blog) { %>

<!-- Article Hero -->
<section style="padding:150px 0 48px;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(108,71,255,.09) 0%,transparent 60%);pointer-events:none"></div>
  <div class="dw-container" style="position:relative;z-index:1">
    <div class="breadcrumb-dw" style="justify-content:flex-start;margin-bottom:24px">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/blog">Blog</a>
      <span class="breadcrumb-sep">/</span>
      <span style="color:var(--text-muted)"><%= blog.name %></span>
    </div>

    <div style="max-width:760px">
      <% if (blog.tags && blog.tags.length > 0) { %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px">
        <% blog.tags.forEach(function(tag) { %>
        <span style="padding:3px 12px;background:rgba(108,71,255,.1);border:1px solid rgba(108,71,255,.2);border-radius:50px;font-size:.72rem;font-weight:600;color:var(--accent)"><%= tag.name %></span>
        <% }); %>
      </div>
      <% } %>

      <h1 style="font-size:clamp(1.8rem,4vw,3rem);margin-bottom:20px;line-height:1.2"><%= blog.name %></h1>

      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:36px;height:36px;border-radius:50%;background:var(--gradient);display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:700;color:#fff;flex-shrink:0">
            <%= blog.authorName ? blog.authorName.charAt(0).toUpperCase() : 'D' %>
          </div>
          <div>
            <p style="font-size:.82rem;font-weight:600;color:var(--text);margin:0"><%= blog.authorName %></p>
            <p style="font-size:.72rem;color:var(--text-faint);margin:0">Dadword IT</p>
          </div>
        </div>
        <span style="font-size:.78rem;color:var(--text-faint)"><i class="far fa-clock" style="margin-right:5px"></i><%= blog.created %></span>
      </div>
    </div>
  </div>
</section>

<!-- Cover image -->
<% if (blog.cover) { %>
<div class="dw-container" style="padding-bottom:0">
  <div style="border-radius:var(--card-radius);overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-lg);margin-bottom:0">
    <img src="<%= blog.cover %>" alt="<%= blog.name %>" style="width:100%;display:block;max-height:500px;object-fit:cover" />
  </div>
</div>
<% } %>

<!-- Main content + sidebar -->
<section style="padding:60px 0 100px">
  <div class="dw-container">
    <div class="blog-layout">

      <!-- Article body -->
      <article class="blog-article">
        <div class="blog-content">
          <%- blog.content %>
        </div>

        <!-- Share -->
        <div class="blog-share">
          <span class="blog-share-label">Share this article</span>
          <div class="blog-share-icons">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= blog.blogUrl %>" target="_blank" rel="noopener" class="share-btn" aria-label="Share on Facebook">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="https://twitter.com/intent/tweet?url=<%= blog.blogUrl %>&text=<%= encodeURIComponent(blog.name) %>" target="_blank" rel="noopener" class="share-btn" aria-label="Share on X">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/></svg>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= blog.blogUrl %>" target="_blank" rel="noopener" class="share-btn" aria-label="Share on LinkedIn">
              <i class="fab fa-linkedin-in"></i>
            </a>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="blog-sidebar">

        <!-- Recent posts -->
        <% if (recent_blogs && recent_blogs.length > 0) { %>
        <div class="sidebar-block">
          <h4 class="sidebar-title">Recent Articles</h4>
          <div style="display:flex;flex-direction:column;gap:0">
            <% recent_blogs.forEach(function(rb) { %>
            <a href="<%= rb.url %>" class="sidebar-post">
              <img src="<%= rb.featuredImage %>" alt="<%= rb.name %>" loading="lazy" />
              <div>
                <p class="sidebar-post-date"><%= rb.created %></p>
                <p class="sidebar-post-title"><%= rb.name %></p>
              </div>
            </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- CTA widget -->
        <div class="sidebar-cta">
          <p class="sidebar-cta-label">Have a project in mind?</p>
          <h4>Let&rsquo;s build it together.</h4>
          <p style="font-size:.85rem;margin-bottom:16px">Senior-led. AI-enhanced. Custom code only.</p>
          <a href="/contact-us" class="btn-primary" style="width:100%;justify-content:center">Start a Project</a>
        </div>

      </aside>
    </div>
  </div>
</section>

<% } else { %>
<section style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:160px 24px">
  <div>
    <h2>Article not found.</h2>
    <p style="margin:14px 0 28px">This article may have been moved or removed.</p>
    <a href="/blog" class="btn-outline btn-lg">&larr; Back to Blog</a>
  </div>
</section>
<% } %>

<%- include('partials/footer', { recent_blogs: recent_blogs || [] }) %>
<script src="/js/dadword.js" defer></script>

<style>
/* Blog article content */
.blog-layout {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 60px;
  align-items: start;
}
@media (max-width: 992px) { .blog-layout { grid-template-columns: 1fr; } }

.blog-article {}

.blog-content {
  font-size: 1.05rem;
  line-height: 1.85;
  color: var(--text-muted);
}
.blog-content h1,
.blog-content h2,
.blog-content h3,
.blog-content h4,
.blog-content h5,
.blog-content h6 {
  color: var(--text);
  margin-top: 2em;
  margin-bottom: .6em;
  font-family: var(--font-display);
  letter-spacing: -.02em;
}
.blog-content h2 { font-size: 1.7rem; }
.blog-content h3 { font-size: 1.35rem; }
.blog-content h4 { font-size: 1.1rem; }
.blog-content p { margin-bottom: 1.2em; color: var(--text-muted); }
.blog-content a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
.blog-content a:hover { color: var(--accent-2); }
.blog-content ul,
.blog-content ol { padding-left: 1.5em; margin-bottom: 1.2em; }
.blog-content ul { list-style: disc; }
.blog-content ol { list-style: decimal; }
.blog-content li { margin-bottom: .5em; color: var(--text-muted); }
.blog-content img { border-radius: 10px; border: 1px solid var(--border); margin: 1.5em 0; }
.blog-content blockquote {
  border-left: 3px solid var(--accent);
  padding: 14px 20px;
  margin: 1.5em 0;
  background: rgba(108,71,255,.06);
  border-radius: 0 8px 8px 0;
  font-style: italic;
  color: var(--text-muted);
}
.blog-content blockquote p { margin: 0; }
.blog-content pre {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 20px;
  overflow-x: auto;
  margin: 1.5em 0;
  font-size: .88rem;
  line-height: 1.6;
}
.blog-content code {
  font-family: 'Fira Code', 'Courier New', monospace;
  font-size: .9em;
}
.blog-content :not(pre) > code {
  padding: 2px 7px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 5px;
  font-size: .85em;
  color: var(--accent-2);
}
.blog-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5em 0;
  font-size: .9rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}
.blog-content th { background: var(--surface-2); color: var(--text); font-weight: 700; padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border); }
.blog-content td { padding: 10px 14px; border-bottom: 1px solid var(--border); }
.blog-content tr:last-child td { border-bottom: none; }
.blog-content hr { border: none; border-top: 1px solid var(--border); margin: 2em 0; }

/* Share */
.blog-share {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
}
.blog-share-label { font-size: .8rem; font-weight: 600; color: var(--text-faint); text-transform: uppercase; letter-spacing: .06em; }
.blog-share-icons { display: flex; gap: 8px; }
.share-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .85rem;
  color: var(--text-muted);
  transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
}
.share-btn:hover { background: rgba(108,71,255,.15); border-color: rgba(108,71,255,.4); color: var(--text); }

/* Sidebar */
.blog-sidebar { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 24px; }
.sidebar-block { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); padding: 24px; }
.sidebar-title { font-size: .78rem; font-weight: 700; color: var(--text-faint); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 16px; }
.sidebar-post {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
  transition: opacity var(--dur) var(--ease);
}
.sidebar-post:last-child { border-bottom: none; padding-bottom: 0; }
.sidebar-post:hover { opacity: .7; }
.sidebar-post img { width: 60px; height: 48px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
.sidebar-post-date { font-size: .68rem; color: var(--text-faint); margin: 0 0 3px; }
.sidebar-post-title { font-size: .82rem; color: var(--text-muted); margin: 0; line-height: 1.4; }

.sidebar-cta {
  background: linear-gradient(135deg, rgba(108,71,255,.1) 0%, rgba(0,212,200,.07) 100%);
  border: 1px solid rgba(108,71,255,.3);
  border-radius: var(--card-radius);
  padding: 24px;
}
.sidebar-cta-label { font-size: .72rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 8px; }
.sidebar-cta h4 { font-size: 1rem; margin-bottom: 8px; }
</style>

</body>
</html>
