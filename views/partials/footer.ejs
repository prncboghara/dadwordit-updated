<footer class="site-footer">
  <div class="dw-container">
    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <img src="/images/white-logo.png" alt="Dadword IT" class="footer-logo" />
        <p class="footer-tagline">Built by engineers who've shipped real products.</p>
        <div class="footer-socials">
          <a href="https://www.facebook.com/people/Dadword-It/61554692296159/" target="_blank" rel="noopener" class="soc-icon" aria-label="Facebook">
            <%- include('icon', { name: 'facebook' }) %>
          </a>
          <a href="https://x.com/dadwordit" target="_blank" rel="noopener" class="soc-icon" aria-label="X / Twitter">
            <svg class="dw-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/dadword_it/" target="_blank" rel="noopener" class="soc-icon" aria-label="Instagram">
            <%- include('icon', { name: 'instagram' }) %>
          </a>
          <a href="https://www.linkedin.com/company/dadword-it/" target="_blank" rel="noopener" class="soc-icon" aria-label="LinkedIn">
            <%- include('icon', { name: 'linkedin' }) %>
          </a>
        </div>
      </div>

      <!-- Work links -->
      <div>
        <p class="footer-col-title">Work</p>
        <ul class="footer-links">
          <li><a href="/our-work">Portfolio</a></li>
          <li><a href="/#product">Customer Story</a></li>
          <li><a href="/service">Services</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <p class="footer-col-title">Company</p>
        <ul class="footer-links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/career">Careers</a></li>
          <li><a href="/lets-talk">Book a Call</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions">Terms</a></li>
        </ul>
      </div>

      <!-- Contact + newsletter -->
      <div>
        <p class="footer-col-title">Contact</p>
        <ul class="footer-links" style="margin-bottom:24px">
          <li>
            <a href="mailto:contact@dadwordit.com">contact@dadwordit.com</a>
          </li>
          <li style="color:var(--text-faint);font-size:.82rem;line-height:1.5">
            N-1007, North Building, Twinstar,<br>150 Feet Ring Road, Rajkot - 360004
          </li>
        </ul>

        <!-- Latest blogs -->
        <% if (typeof recent_blogs !== 'undefined' && recent_blogs && recent_blogs.length > 0) { %>
        <p class="footer-col-title" style="margin-top:24px">Latest Posts</p>
        <% recent_blogs.slice(0, 2).forEach(function(blog) { %>
        <a href="<%= blog.url %>" class="footer-blog-item">
          <p class="footer-blog-date"><span style="margin-right:4px"><%- include('icon', { name: 'clock' }) %></span><%= blog.created %></p>
          <p class="footer-blog-title"><%= blog.name %></p>
        </a>
        <% }); %>
        <% } %>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; 2020 - <%= new Date().getFullYear() %> <a href="/">Dadword IT</a>. All rights reserved.
      </p>
      <div class="footer-legal">
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-and-conditions">Terms</a>
        <a href="/contact-us">Contact</a>
      </div>
    </div>

  </div>
</footer>
