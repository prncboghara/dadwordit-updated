<div class="dw-form">
  <form id="dw-contact-form" novalidate>

    <div id="dw-form-msg" class="form-msg-box" role="alert"></div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-lbl" for="f-name">Full Name *</label>
        <input class="form-inp" type="text" id="f-name" name="full_name" placeholder="Prince Boghara" required />
      </div>
      <div class="form-group">
        <label class="form-lbl" for="f-email">Email Address *</label>
        <input class="form-inp" type="email" id="f-email" name="email" placeholder="hello@yourcompany.com" required />
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-lbl" for="f-company">Company / Project</label>
        <input class="form-inp" type="text" id="f-company" name="company" placeholder="Acme Inc." />
      </div>
      <div class="form-group">
        <label class="form-lbl" for="f-phone">Phone (optional)</label>
        <input class="form-inp" type="tel" id="f-phone" name="phone" placeholder="+1 555 000 0000" />
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-lbl" for="f-service">Project Type *</label>
        <select class="form-sel" id="f-service" name="service" required>
          <option value="" disabled selected>Select type&hellip;</option>
          <option value="Web Portal">Custom Web Portal</option>
          <option value="Shopify App">Shopify App Development</option>
          <option value="SaaS Product">SaaS Product Engineering</option>
          <option value="AI Development">AI-Enhanced Development</option>
          <option value="Legacy Modernization">Legacy Modernization</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-lbl" for="f-budget">Estimated Budget</label>
        <select class="form-sel" id="f-budget" name="budget">
          <option value="" disabled selected>Budget range&hellip;</option>
          <option value="Under $5k">Under $5,000</option>
          <option value="$5k-$15k">$5,000 &ndash; $15,000</option>
          <option value="$15k-$50k">$15,000 &ndash; $50,000</option>
          <option value="$50k+">$50,000+</option>
          <option value="Not sure">Not sure yet</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-lbl" for="f-message">Tell us about your project *</label>
      <textarea class="form-ta" id="f-message" name="message" placeholder="Briefly describe what you want to build, the problem you're solving, and any timeline you have in mind..." required></textarea>
    </div>

    <button type="submit" class="btn-submit">
      <span class="btn-txt">Send Message</span>
      <span class="btn-spin"></span>
    </button>

    <p class="form-alt-note">
      Prefer a call?
      <a href="/lets-talk">Book a free 30-min strategy session &rarr;</a>
    </p>

  </form>
</div>
