<head>
  <meta charset="utf-8" />
  <title><%= title %></title>

  <% if (typeof meta.description !== 'undefined' && meta.description) { %>
  <meta name="description" content="<%= meta.description %>">
  <% } %>
  <% if (typeof meta.keywords !== 'undefined' && meta.keywords) { %>
  <meta name="keywords" content="<%= meta.keywords %>">
  <% } %>
  <% if (typeof meta.author !== 'undefined' && meta.author) { %>
  <meta name="author" content="<%= meta.author %>">
  <% } %>

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="#6c47ff">

  <!-- Open Graph -->
  <% if (typeof og !== 'undefined' && og) { %>
  <% if (og.title)       { %><meta property="og:title"       content="<%= og.title %>"><% } %>
  <% if (og.description) { %><meta property="og:description" content="<%= og.description %>"><% } %>
  <% if (og.image)       { %><meta property="og:image"       content="<%= og.image %>"><% } %>
  <% if (og.url)         { %><meta property="og:url"         content="<%= og.url %>"><% } %>
  <% if (og.type)        { %><meta property="og:type"        content="<%= og.type %>"><% } %>
  <% } %>

  <!-- Twitter Card -->
  <% if (typeof twitter !== 'undefined' && twitter) { %>
  <% if (twitter.card)        { %><meta name="twitter:card"        content="<%= twitter.card %>"><% } %>
  <% if (twitter.title)       { %><meta name="twitter:title"       content="<%= twitter.title %>"><% } %>
  <% if (twitter.description) { %><meta name="twitter:description" content="<%= twitter.description %>"><% } %>
  <% if (twitter.image)       { %><meta name="twitter:image"       content="<%= twitter.image %>"><% } %>
  <% } %>

  <!-- Canonical -->
  <% if (typeof canonical !== 'undefined' && canonical) { %>
  <link rel="canonical" href="<%= canonical %>" />
  <% } %>

  <!-- Structured Data -->
  <% if (typeof schema !== 'undefined' && schema) { %>
  <script type="application/ld+json"><%- JSON.stringify(schema) %></script>
  <% } %>

  <!-- Favicon -->
  <link href="/images/favicon.png" rel="icon">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap grid only -->
  <link href="/css/bootstrap.min.css" rel="stylesheet" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link href="/css/bootstrap.min.css" rel="stylesheet"></noscript>

  <!-- Dadword Design System -->
  <link href="/css/dadword.css" rel="stylesheet">

  <!-- Font Awesome icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"></noscript>

  <!-- Regional SEO (office NAP) -->
  <meta name="geo.region"    content="IN-GJ" />
  <meta name="geo.placename" content="Rajkot" />
  <meta name="geo.position"  content="22.2969;70.7984" />
  <meta name="ICBM"          content="22.2969, 70.7984" />

  <% const hreflangUrl = (typeof canonical !== 'undefined' && canonical) ? canonical : 'https://www.dadwordit.com/'; %>
  <link rel="alternate" hreflang="en" href="<%= hreflangUrl %>" />
  <link rel="alternate" hreflang="x-default" href="<%= hreflangUrl %>" />

  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= trackingId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', "<%= trackingId %>");
  </script>
</head>
