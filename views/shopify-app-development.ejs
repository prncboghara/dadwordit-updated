<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, canonical, trackingId}) %>
<body>

<%- include('partials/header') %>

<!-- =========================================================
     HERO
     ========================================================= -->
<section class="wl-hero">
  <div class="dw-container">
    <div class="wl-hero-grid">

      <div class="wl-hero-copy">
        <div class="breadcrumb-dw" style="justify-content:flex-start">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">/</span>
          <a href="/service">Services</a>
          <span class="breadcrumb-sep">/</span>
          <span>Shopify App Development</span>
        </div>
        <span class="section-label">Shopify App Development</span>
        <h1>Custom Shopify apps, <em>built for how you sell.</em></h1>
        <p class="wl-hero-sub">
          When off-the-shelf apps can't handle your bundles, pricing or workflows, we build the
          app your store actually needs. Custom and public apps, Shopify Functions and theme
          extensions, for merchants and agencies in the US, UK, Canada, Australia, Europe and the Gulf.
        </p>
        <div class="hero-ctas">
          <a href="/contact-us?type=shopify" class="btn-primary btn-lg">Get a Shopify App Quote</a>
          <a href="/lets-talk" class="btn-outline btn-lg">Book a Call</a>
        </div>
        <%- include('partials/upwork-proof', { variant: 'inline' }) %>
      </div>

      <aside class="wl-promise dw-ink" aria-label="What we build on Shopify">
        <p class="wl-promise-title">What merchants hire us for</p>
        <ul class="sa-list">
          <li><strong>Bundles &amp; pricing logic</strong><span>Build-your-own bundles, tiered and dynamic pricing, custom discounts with Shopify Functions.</span></li>
          <li><strong>Custom admin apps</strong><span>Embedded tools for your team inside Shopify admin: orders, inventory, reporting.</span></li>
          <li><strong>Integrations</strong><span>Connect Shopify to your ERP, CRM, 3PL or internal systems through the Admin API and webhooks.</span></li>
          <li><strong>Storefront features</strong><span>Theme app extensions and custom sections your team can edit without a developer.</span></li>
          <li><strong>Public App Store apps</strong><span>From MVP to listing, including billing and Shopify's app review.</span></li>
        </ul>
      </aside>

    </div>
  </div>
</section>

<!-- =========================================================
     WHO IT'S FOR
     ========================================================= -->
<section class="dw-section">
  <div class="dw-container">
    <div class="services-header">
      <span class="section-label reveal">Who It's For</span>
      <h2 class="reveal reveal-d1">When the App Store <em>runs out.</em></h2>
      <p class="section-sub reveal reveal-d2">
        Most stores start with off-the-shelf apps. You come to us when you're stacking
        five of them to fake one feature, or when no app does what your business needs.
      </p>
    </div>

    <div class="wl-audience">
      <div class="wl-aud-item reveal">
        <h3>Growing Shopify brands</h3>
        <p>Replace a stack of overlapping apps with one custom app that fits your catalogue and pricing.</p>
      </div>
      <div class="wl-aud-item reveal reveal-d1">
        <h3>Shopify Plus merchants</h3>
        <p>Checkout extensions, B2B pricing and integrations that match how your operations already run.</p>
      </div>
      <div class="wl-aud-item reveal reveal-d2">
        <h3>SaaS founders</h3>
        <p>Turn your product into a public Shopify app, ready for App Store review and billing.</p>
      </div>
      <div class="wl-aud-item reveal reveal-d3">
        <h3>Agencies</h3>
        <p>Hand off the app build while you keep the client. <a href="/white-label">See white-label partnerships</a>.</p>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     WHAT WE BUILD
     ========================================================= -->
<section class="dw-section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="dw-container">
    <div class="services-header">
      <span class="section-label reveal">What We Build</span>
      <h2 class="reveal reveal-d1">Shopify apps and features, <em>end to end.</em></h2>
    </div>

    <div class="services-grid">
      <div class="service-card reveal">
        <h3>Custom (private) apps</h3>
        <p>Apps built for one store and installed only there. No App Store review, fastest route to a working feature.</p>
      </div>
      <div class="service-card reveal reveal-d1">
        <h3>Public App Store apps</h3>
        <p>Multi-store apps with OAuth install, Shopify billing, onboarding and a listing that passes Shopify's review.</p>
      </div>
      <div class="service-card reveal reveal-d2">
        <h3>Bundles, pricing &amp; discounts</h3>
        <p>Custom bundles, tiered and dynamic pricing and discount rules, run server-side with Shopify Functions.</p>
      </div>
      <div class="service-card reveal">
        <h3>Theme app extensions</h3>
        <p>App blocks and custom sections that merchants add and edit in the theme editor, without touching code.</p>
      </div>
      <div class="service-card reveal reveal-d1">
        <h3>Integrations &amp; automation</h3>
        <p>Sync orders, stock and customers with ERPs, CRMs and fulfilment partners using the Admin API and webhooks.</p>
      </div>
      <div class="service-card reveal reveal-d2">
        <h3>Headless storefronts</h3>
        <p>Hydrogen or Next.js storefronts on the Storefront API when you need full control over the front end.</p>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     CASE STUDY
     ========================================================= -->
<% if (shopifyCase) { %>
<section class="dw-section">
  <div class="dw-container">
    <span class="section-label reveal">Case Study</span>
    <h2 class="reveal reveal-d1">Shopify work, <em>in production.</em></h2>

    <div class="case-list" style="margin-top:48px">
      <div class="case-row reveal">
        <a href="<%= shopifyCase.link %>" target="_blank" rel="noopener" class="case-browser">
          <div class="case-browser-bar">
            <span style="background:#ff5f57"></span>
            <span style="background:#febc2e"></span>
            <span style="background:#28c840"></span>
          </div>
          <img src="<%= shopifyCase.image %>" alt="<%= shopifyCase.title %> Shopify store" width="1200" height="661" loading="lazy" />
        </a>
        <div class="case-content">
          <span class="case-category"><%= shopifyCase.category %></span>
          <h3 class="case-title"><%= shopifyCase.title %></h3>
          <div class="case-block">
            <p class="case-block-label">Problem</p>
            <p class="case-block-text"><%= shopifyCase.problem %></p>
          </div>
          <div class="case-block">
            <p class="case-block-label">Solution</p>
            <p class="case-block-text"><%= shopifyCase.solution %></p>
          </div>
          <div class="case-block">
            <p class="case-block-label">Result</p>
            <p class="case-block-text case-result"><%= shopifyCase.result %></p>
          </div>
          <a href="<%= shopifyCase.link %>" target="_blank" rel="noopener" class="case-cta">View Live Store &rarr;</a>
        </div>
      </div>
    </div>

    <% if (shopifyPortfolio && shopifyPortfolio.length) { %>
    <p class="sa-more reveal">
      More Shopify work:
      <% shopifyPortfolio.forEach(function(p, i) { %>
        <a href="/portfolio/<%= p.slug %>"><%= p.sortTitle || p.title %></a><%= i < shopifyPortfolio.length - 1 ? ', ' : '' %>
      <% }); %>
      &middot; <a href="/our-work">All projects</a>
    </p>
    <% } %>
  </div>
</section>
<% } %>

<!-- =========================================================
     REVIEW
     ========================================================= -->
<% if (shopifyQuote) { %>
<section class="wl-quote-section" style="padding-top:0">
  <div class="dw-container">
    <figure class="wl-quote reveal">
      <blockquote>&ldquo;<%= shopifyQuote.text %>&rdquo;</blockquote>
      <figcaption>
        <strong><%= shopifyQuote.name %></strong>, <%= shopifyQuote.role %>
        <% if (shopifyQuote.sourceUrl) { %>
        &middot; <a href="<%= shopifyQuote.sourceUrl %>" target="_blank" rel="noopener">Verified on <%= shopifyQuote.source %></a>
        <% } %>
      </figcaption>
    </figure>
  </div>
</section>
<% } %>

<!-- =========================================================
     PROCESS
     ========================================================= -->
<section class="dw-section" style="border-top:1px solid var(--border)">
  <div class="dw-container">
    <div class="row">
      <div class="col-lg-5">
        <span class="section-label reveal">How It Works</span>
        <h2 class="reveal reveal-d1">From idea to <em>installed app.</em></h2>
        <p class="section-sub reveal reveal-d2">
          Every app is built and tested on a development store first, so your live
          store is never the test environment.
        </p>
      </div>
      <div class="col-lg-7">
        <div class="process-steps">
          <div class="process-step reveal">
            <div class="step-num">01</div>
            <div class="step-body">
              <h4>Discovery &amp; app spec</h4>
              <p>We map the feature to Shopify's building blocks (Admin API, Functions, extensions) and confirm what your plan supports. Output: a written spec with timeline and fixed price.</p>
            </div>
          </div>
          <div class="process-step reveal reveal-d1">
            <div class="step-num">02</div>
            <div class="step-body">
              <h4>Prototype on a dev store</h4>
              <p>You click through a working prototype with your real products before full development starts.</p>
            </div>
          </div>
          <div class="process-step reveal reveal-d2">
            <div class="step-num">03</div>
            <div class="step-body">
              <h4>Build &amp; test</h4>
              <p>Built with Shopify's app tooling, Polaris and App Bridge for the admin, and tested against real orders, discounts and edge cases.</p>
            </div>
          </div>
          <div class="process-step reveal reveal-d3">
            <div class="step-num">04</div>
            <div class="step-body">
              <h4>Install or App Store launch</h4>
              <p>Custom apps are installed on your store. Public apps go through Shopify's app review, and we handle the submission and any fixes it asks for.</p>
            </div>
          </div>
          <div class="process-step reveal reveal-d4">
            <div class="step-num">05</div>
            <div class="step-body">
              <h4>Maintenance</h4>
              <p>Shopify ships a new API version every quarter. We keep your app current, fix issues and add features on a monthly plan.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     STACK
     ========================================================= -->
<section class="dw-section" style="padding-top:0">
  <div class="dw-container">
    <span class="section-label reveal">Stack</span>
    <h2 class="reveal reveal-d1">Built on Shopify's <em>own tooling.</em></h2>
    <div class="tech-grid reveal reveal-d2">
      <span class="tech-pill">Shopify Admin GraphQL API</span>
      <span class="tech-pill">Storefront API</span>
      <span class="tech-pill">Shopify Functions</span>
      <span class="tech-pill">Theme app extensions</span>
      <span class="tech-pill">Checkout UI extensions</span>
      <span class="tech-pill">Polaris</span>
      <span class="tech-pill">App Bridge</span>
      <span class="tech-pill">Webhooks</span>
      <span class="tech-pill">Liquid</span>
      <span class="tech-pill">Hydrogen</span>
      <span class="tech-pill">Node.js</span>
      <span class="tech-pill">React</span>
      <span class="tech-pill">PostgreSQL &amp; Prisma</span>
    </div>
  </div>
</section>

<!-- =========================================================
     FAQ
     ========================================================= -->
<section class="dw-section" style="background:var(--surface);border-top:1px solid var(--border)">
  <div class="dw-container">
    <div class="work-faq reveal" style="margin:0 auto">
      <span class="section-label">FAQ</span>
      <h2>Shopify app <em>questions.</em></h2>
      <div class="faq-list">
        <% shopifyFaq.forEach(function(f, i) { %>
        <div class="faq-item" data-faq>
          <button class="faq-q" aria-expanded="<%= i === 0 ? 'true' : 'false' %>">
            <%= f.q %>
            <span class="faq-icon"><%- include('partials/icon', { name: 'plus' }) %></span>
          </button>
          <div class="faq-a">
            <p><%= f.a %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     CTA
     ========================================================= -->
<section class="cta-section dw-section">
  <div class="dw-container">
    <span class="section-label" style="justify-content:center">Start Your App</span>
    <h2 class="reveal">Tell us what your store <em>needs to do.</em></h2>
    <p class="reveal reveal-d1">Send the feature you're missing. We'll reply within 24 hours with how we'd build it on Shopify.</p>
    <div class="cta-btns reveal reveal-d2">
      <a href="/contact-us?type=shopify" class="btn-primary btn-lg">Get a Shopify App Quote</a>
      <a href="/lets-talk" class="btn-outline btn-lg">Book a Call</a>
    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: recent_blogs }) %>
<script src="/js/dadword.js?v=4.2" defer></script>
</body>
</html>
