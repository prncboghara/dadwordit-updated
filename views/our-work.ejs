<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, trackingId}) %>
<body>

<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<%- include('partials/header') %>

<!-- Page Hero -->
<section class="page-hero">
  <div class="dw-container">
    <div class="page-hero-content">
      <div class="breadcrumb-dw">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Our Work</span>
      </div>
      <span class="section-label">Portfolio</span>
      <h1>Products we've built<br>for real businesses.</h1>
      <p class="section-sub mx-auto">
        Every project here started with a real problem and ended with a measurable outcome.
        No filler, no spec work.
      </p>
    </div>
  </div>
</section>

<!-- Portfolio Grid -->
<section class="work-section">
  <div class="dw-container">

    <!-- Filters -->
    <div class="work-filters">
      <button class="filter-btn active" data-filter="all">All Work</button>
      <button class="filter-btn" data-filter="Web Portal">Web Portal</button>
      <button class="filter-btn" data-filter="Shopify">Shopify</button>
      <button class="filter-btn" data-filter="SaaS">SaaS</button>
    </div>

    <div class="portfolio-grid">
      <% portfolioItems.forEach(function(item, index) { %>
      <%
        var cat = 'Web Portal';
        var techs = item.technologies || [];
        if (techs.some(function(t){ return t.toLowerCase().indexOf('shopify') > -1; })) cat = 'Shopify';
        if (techs.some(function(t){ return t.toLowerCase().indexOf('node') > -1; }) &&
            techs.some(function(t){ return t.toLowerCase().indexOf('react') > -1; })) cat = 'SaaS';
      %>
      <div class="port-card reveal" data-category="<%= cat %>">
        <div class="port-img-wrap">
          <img src="<%= item.portfolioImg %>" alt="<%= item.sortTitle %>" loading="<%= index < 2 ? 'eager' : 'lazy' %>" />
          <div class="port-overlay">
            <a href="/portfolio/<%= item.slug %>" class="btn-primary" style="font-size:.85rem;padding:10px 20px">View Case Study</a>
          </div>
        </div>
        <div class="port-body">
          <div class="port-tags">
            <span class="port-tag"><%= cat %></span>
            <% (item.technologies || []).slice(0, 2).forEach(function(tech) { %>
            <span class="port-tag"><%= tech %></span>
            <% }); %>
          </div>
          <h3><%= item.sortTitle %></h3>
          <p><%= item.title.split(' - ')[1] || item.title %></p>
        </div>
      </div>
      <% }); %>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="cta-section dw-section">
  <div class="dw-container">
    <span class="section-label" style="justify-content:center">Next Project</span>
    <h2 class="reveal">Want your project here?</h2>
    <p class="reveal reveal-d1">Let's talk about what you're building.</p>
    <div class="cta-btns reveal reveal-d2">
      <a href="/contact-us" class="btn-primary btn-lg">Start a Project</a>
      <a href="/lets-talk" class="btn-outline btn-lg">Book a Call</a>
    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: recent_blogs }) %>
<script src="/js/dadword.js" defer></script>
</body>
</html>
