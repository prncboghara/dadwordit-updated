<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, trackingId}) %>
<body>

<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<%- include('partials/header') %>

<section class="lt-page">
  <div class="dw-container">

    <div class="lt-layout">

      <!-- LEFT: context + trust -->
      <div class="lt-left">

        <div class="breadcrumb-dw" style="justify-content:flex-start;margin-bottom:28px">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">/</span>
          <span>Book a Call</span>
        </div>

        <span class="section-label" style="margin-bottom:12px">Free 30-Min Call</span>
        <h1 class="lt-title">Let's talk about<br>your project.</h1>
        <p class="lt-sub">
          No sales pitch, no obligation. Just a straight conversation with a
          senior engineer about your idea, challenge, or roadmap.
        </p>

        <!-- What to expect -->
        <div class="lt-expect">
          <p class="lt-expect-title">What we cover in 30 minutes</p>
          <ul class="lt-checklist">
            <li>
              <span class="lt-check">&#10003;</span>
              Your project goals and timeline
            </li>
            <li>
              <span class="lt-check">&#10003;</span>
              The right tech stack for your use case
            </li>
            <li>
              <span class="lt-check">&#10003;</span>
              Rough scope and budget fit
            </li>
            <li>
              <span class="lt-check">&#10003;</span>
              Next steps if we're a good match
            </li>
          </ul>
        </div>

        <!-- Trust signals -->
        <div class="lt-trust">
          <div class="lt-trust-item">
            <div class="lt-trust-avatar">S</div>
            <div>
              <p class="lt-trust-quote">"They're very professional and deliver with a high level of technical knowledge."</p>
              <p class="lt-trust-name">Sergiu Manolache, CEO, Sergman Software</p>
            </div>
          </div>
          <div class="lt-trust-item">
            <div class="lt-trust-avatar" style="background:var(--accent-2)">Y</div>
            <div>
              <p class="lt-trust-quote">"Dadword IT is the ideal software agency. Passionate, communicative, and smart."</p>
              <p class="lt-trust-name">Yashar Evazi, CEO, ESGWAY</p>
            </div>
          </div>
        </div>

        <!-- Contact fallback -->
        <div class="lt-fallback">
          <span>Prefer email?</span>
          <a href="mailto:contact@dadwordit.com">contact@dadwordit.com</a>
        </div>

      </div>

      <!-- RIGHT: Calendly embed -->
      <div class="lt-right">
        <div class="lt-calendar-wrap">
          <div class="lt-calendar-label">
            <span class="lt-cal-dot"></span>
            Pick a time that works for you
          </div>
          <div class="calendly-inline-widget"
               data-url="https://calendly.com/dadwordit/project-discussion-strategy-call?hide_event_type_details=1&hide_gdpr_banner=1&background_color=0a0a0f&text_color=e2e2e8&primary_color=6c47ff"
               style="min-width:280px;height:680px">
          </div>
          <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: recent_blogs }) %>
<script src="/js/dadword.js" defer></script>

<style>
.lt-page {
  padding-top: 140px;
  padding-bottom: 100px;
  min-height: 100vh;
}

.lt-layout {
  display: grid;
  grid-template-columns: 1fr 520px;
  gap: 72px;
  align-items: start;
}

@media (max-width: 1100px) {
  .lt-layout { grid-template-columns: 1fr; gap: 48px; }
}

/* Left */
.lt-title {
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.15;
  margin-bottom: 16px;
}
.lt-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 36px;
  max-width: 480px;
}

.lt-expect {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 24px 28px;
  margin-bottom: 32px;
}
.lt-expect-title {
  font-size: .78rem;
  font-weight: 700;
  color: var(--text-faint);
  text-transform: uppercase;
  letter-spacing: .07em;
  margin-bottom: 16px;
}
.lt-checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.lt-checklist li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: .9rem;
  color: var(--text-muted);
}
.lt-check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(0,212,200,.12);
  border: 1px solid rgba(0,212,200,.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .7rem;
  color: var(--accent-2);
  flex-shrink: 0;
  font-weight: 700;
}

/* Trust quotes */
.lt-trust {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 28px;
}
.lt-trust-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 16px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.lt-trust-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .9rem;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.lt-trust-quote {
  font-size: .82rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0 0 5px;
  font-style: italic;
}
.lt-trust-name {
  font-size: .72rem;
  color: var(--text-faint);
  margin: 0;
  font-weight: 600;
}

.lt-fallback {
  font-size: .85rem;
  color: var(--text-faint);
  display: flex;
  align-items: center;
  gap: 8px;
}
.lt-fallback a {
  color: var(--accent);
  font-weight: 600;
}
.lt-fallback a:hover { color: var(--accent-2); }

/* Right: Calendly wrapper */
.lt-right { position: sticky; top: 100px; }

.lt-calendar-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}
.lt-calendar-label {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  font-size: .8rem;
  font-weight: 600;
  color: var(--text-muted);
}
.lt-cal-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-2);
  box-shadow: 0 0 8px rgba(0,212,200,.5);
  flex-shrink: 0;
}
.calendly-inline-widget {
  border: none;
}
</style>

</body>
</html>
