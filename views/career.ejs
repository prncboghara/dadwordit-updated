<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, canonical, trackingId}) %>
<body>

<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<%- include('partials/header') %>

<section class="inner-page-hero">
  <div class="dw-container">
    <div class="breadcrumb-dw">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">/</span>
      <span>Careers</span>
    </div>
    <h1 class="inner-page-title">Careers at Dadword IT</h1>
    <p class="inner-page-sub">
      Join a lean, senior-led team building real products for growing businesses.
    </p>
  </div>
</section>

<!-- Culture section -->
<section class="career-culture">
  <div class="dw-container">
    <div class="culture-grid">
      <div class="culture-text">
        <span class="section-label">Why work with us</span>
        <h2 class="section-title" style="font-size:clamp(1.6rem,3vw,2.2rem)">Build things that matter.<br>Grow every week.</h2>
        <p>At Dadword IT we foster a culture of craft and accountability. Our engineers work on real products with real users, not agency throw-away work. You will have ownership, a direct line to decision-makers, and the freedom to push for quality.</p>
        <p>We use modern tooling including AI-assisted workflows, so you will ship faster and spend more time on the hard, interesting problems.</p>
        <a href="#jobs" class="dw-btn-primary" style="margin-top:8px">View Open Roles</a>
      </div>
      <div class="culture-pillars">
        <div class="culture-pillar">
          <span class="pillar-icon"><%- include('partials/icon', { name: 'code-branch' }) %></span>
          <div>
            <h4>Ownership</h4>
            <p>You own your code end to end, from design review to deployment.</p>
          </div>
        </div>
        <div class="culture-pillar">
          <span class="pillar-icon"><%- include('partials/icon', { name: 'bolt' }) %></span>
          <div>
            <h4>AI-First Workflow</h4>
            <p>We use Cursor, Claude, and other AI tools as standard — not as experiments.</p>
          </div>
        </div>
        <div class="culture-pillar">
          <span class="pillar-icon"><%- include('partials/icon', { name: 'trend-up' }) %></span>
          <div>
            <h4>Real Growth</h4>
            <p>Senior engineers who mentor, not gatekeep. Grow your skills on every sprint.</p>
          </div>
        </div>
        <div class="culture-pillar">
          <span class="pillar-icon"><%- include('partials/icon', { name: 'globe' }) %></span>
          <div>
            <h4>Remote-Friendly</h4>
            <p>We care about output, not hours. Work from wherever you do your best thinking.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Jobs section -->
<section class="career-jobs" id="jobs">
  <div class="dw-container">
    <div class="jobs-header">
      <span class="section-label">Open roles</span>
      <h2 class="section-title" style="font-size:clamp(1.6rem,3vw,2.2rem)">Current Openings</h2>
    </div>

    <div id="jobs-list">
      <div class="jobs-loading">
        <div class="jobs-spinner"></div>
        <p>Loading openings...</p>
      </div>
    </div>

    <div class="jobs-empty" id="jobs-empty" style="display:none">
      <p>No open roles at the moment. We do hire on a rolling basis.</p>
      <a href="/contact-us" class="dw-btn-outline">Send us your CV anyway</a>
    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: recent_blogs }) %>
<script src="/js/dadword.js" defer></script>

<script>
(function () {
  const SHEET_URL = "https://docs.google.com/spreadsheets/d/1BDnfKov1N5hjxalZz7PaJy9J_UMgk2zjYfxVQGxcNd4/gviz/tq?tqx=out:json";
  const container = document.getElementById('jobs-list');
  const emptyMsg  = document.getElementById('jobs-empty');

  fetch(SHEET_URL)
    .then(r => r.text())
    .then(data => {
      const json    = JSON.parse(data.substring(47).slice(0, -2));
      const rows    = json.table.rows;
      const jobList = rows.map(row => ({
        title:               row.c[0]?.v,
        num_of_posts:        row.c[1]?.v,
        description:         row.c[2]?.v,
        required_skills:     row.c[3]?.v,
        required_experience: row.c[4]?.v,
        location:            row.c[5]?.v,
        job_type:            row.c[6]?.v,
        applyLink:           row.c[7]?.v
      })).filter(j => j.title);

      container.innerHTML = '';

      if (!jobList.length) {
        emptyMsg.style.display = 'block';
        return;
      }

      jobList.forEach((job, i) => {
        const skills    = (job.required_skills || '').split(',').filter(Boolean);
        const skillHtml = skills.map(s => `<li>${s.trim()}</li>`).join('');
        const meta      = [job.location, job.job_type].filter(Boolean).join(' &middot; ');

        const el = document.createElement('div');
        el.className = 'job-item';
        el.dataset.job = i;
        el.innerHTML = `
          <div class="job-header">
            <div class="job-header-left">
              <h3 class="job-title">${job.title}</h3>
              ${meta ? `<p class="job-meta">${meta}</p>` : ''}
            </div>
            <div class="job-header-right">
              ${job.num_of_posts ? `<span class="job-badge">${job.num_of_posts} opening${job.num_of_posts > 1 ? 's' : ''}</span>` : ''}
              <span class="job-toggle-icon"><svg class="dw-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true"><path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32V224H48c-17.7 0-32 14.3-32 32s14.3 32 32 32H192V432c0 17.7 14.3 32 32 32s32-14.3 32-32V288H400c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z"/></svg></span>
            </div>
          </div>
          <div class="job-body">
            ${job.description ? `<p>${job.description}</p>` : ''}
            ${job.required_experience ? `<p><strong>Experience:</strong> ${job.required_experience}</p>` : ''}
            ${skillHtml ? `<p class="skills-label">Skills Required</p><ul class="job-skills">${skillHtml}</ul>` : ''}
            ${job.applyLink ? `<a href="${job.applyLink}" target="_blank" rel="noopener" class="dw-btn-primary" style="margin-top:16px;display:inline-flex">Apply Now <svg class="dw-icon" style="margin-left:6px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true"><path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg></a>` : ''}
          </div>
        `;

        el.querySelector('.job-header').addEventListener('click', () => {
          const isOpen = el.classList.contains('open');
          document.querySelectorAll('.job-item').forEach(j => j.classList.remove('open'));
          if (!isOpen) el.classList.add('open');
        });

        container.appendChild(el);
      });
    })
    .catch(err => {
      console.error('Error loading jobs:', err);
      container.innerHTML = '';
      emptyMsg.style.display = 'block';
    });
})();
</script>

<style>
.inner-page-hero {
  padding-top: 140px;
  padding-bottom: 60px;
}
.inner-page-title {
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.2;
  margin: 12px 0 16px;
}
.inner-page-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 560px;
}

/* Culture */
.career-culture { padding-bottom: 80px; }
.culture-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}
@media (max-width: 900px) { .culture-grid { grid-template-columns: 1fr; gap: 40px; } }
.culture-text p {
  color: var(--text-muted);
  line-height: 1.75;
  margin-bottom: 14px;
}
.culture-pillars {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
@media (max-width: 480px) { .culture-pillars { grid-template-columns: 1fr; } }
.culture-pillar {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
}
.pillar-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: rgba(108,71,255,.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .85rem;
  color: var(--accent);
  flex-shrink: 0;
}
.culture-pillar h4 {
  font-size: .85rem;
  font-weight: 700;
  margin: 0 0 4px;
}
.culture-pillar p {
  font-size: .78rem;
  color: var(--text-faint);
  margin: 0;
  line-height: 1.5;
}

/* Jobs */
.career-jobs { padding-bottom: 100px; }
.jobs-header { margin-bottom: 36px; }

.jobs-loading {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 32px 0;
  color: var(--text-faint);
  font-size: .85rem;
}
.jobs-spinner {
  width: 20px;
  height: 20px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}
@keyframes spin { to { rotate: 360deg; } }

.jobs-empty {
  text-align: center;
  padding: 60px 20px;
  color: var(--text-faint);
}
.jobs-empty p { margin-bottom: 20px; }

.job-item {
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 12px;
  overflow: hidden;
  transition: border-color .2s;
}
.job-item:hover, .job-item.open { border-color: var(--accent); }
.job-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  cursor: pointer;
  gap: 16px;
}
.job-header-left { flex: 1; }
.job-title {
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--text-primary);
}
.job-meta {
  font-size: .78rem;
  color: var(--text-faint);
  margin: 0;
}
.job-header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}
.job-badge {
  font-size: .72rem;
  font-weight: 700;
  color: var(--accent);
  background: rgba(108,71,255,.12);
  border: 1px solid rgba(108,71,255,.25);
  border-radius: 20px;
  padding: 3px 10px;
  white-space: nowrap;
}
.job-toggle-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .65rem;
  color: var(--text-faint);
  transition: all .25s;
  flex-shrink: 0;
}
.job-item.open .job-toggle-icon {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  rotate: 45deg;
}

.job-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height .35s ease, padding .35s ease;
  padding: 0 24px;
}
.job-item.open .job-body {
  max-height: 600px;
  padding: 0 24px 24px;
}
.job-body p {
  font-size: .88rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0 0 12px;
}
.job-body strong { color: var(--text-primary); }
.skills-label {
  font-size: .75rem;
  font-weight: 700;
  color: var(--text-faint);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin: 16px 0 8px !important;
}
.job-skills {
  list-style: none;
  padding: 0;
  margin: 0 0 4px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.job-skills li {
  font-size: .78rem;
  color: var(--text-muted);
  background: var(--surface-2, rgba(255,255,255,.04));
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 10px;
}
</style>

</body>
</html>
