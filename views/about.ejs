<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, canonical, trackingId}) %>
<body>

<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<%- include('partials/header') %>

<!-- Page Hero -->
<section class="page-hero">
  <div class="dw-container">
    <div class="page-hero-content">
      <div class="breadcrumb-dw">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>About</span>
      </div>
      <span class="section-label">Our Story</span>
      <h1>Boutique. Senior-led.<br>AI-augmented.</h1>
      <p class="section-sub mx-auto">
        We're a lean, experienced engineering team that builds products
        for the long haul, not just to hit a deadline.
      </p>
    </div>
  </div>
</section>

<!-- Story Section -->
<section class="about-story dw-section">
  <div class="dw-container">
    <div class="about-story-grid">

      <div class="about-story-body">
        <span class="section-label reveal">Who We Are</span>
        <h2 class="reveal reveal-d1">We build products,<br>not just websites.</h2>
        <div class="about-story-body reveal reveal-d2" style="margin-top:24px">
          <p>
            Dadword IT started as a small team of engineers who wanted to build things
            that actually work at scale. Over five years, we've grown into a boutique
            development partner for startups and product companies in the US, Canada,
            and Europe.
          </p>
          <p>
            We specialise in custom web portals, Shopify app development, and SaaS
            product engineering. The kind of work that requires both deep technical
            knowledge and business thinking.
          </p>
          <p>
            In 2024, we integrated AI-assisted engineering (Cursor + Claude) into our
            daily workflow. Not as a shortcut, but as a force multiplier. We ship
            senior-quality work in less time, which means lower costs and faster
            time-to-market for you.
          </p>
          <p>
            Our own product, <a href="https://customersstory.com" target="_blank" rel="noopener" style="color:var(--accent);font-weight:600">Customer Story</a>, is a live Shopify app
            used by merchants worldwide. Building something yourself is
            the fastest way to understand what clients really need.
          </p>
        </div>
      </div>

      <div class="reveal reveal-d2">
        <div class="about-highlight-box">
          <blockquote>
            We don't hire junior engineers for client projects.
            Every engagement is handled by people who've shipped real products,
            encountered real edge cases, and learned from real mistakes.
          </blockquote>
        </div>

        <div style="margin-top:20px;display:flex;flex-direction:column;gap:14px">
          <div style="padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:12px;display:flex;gap:14px;align-items:flex-start">
            <span style="font-size:1.5rem">&#127760;</span>
            <div>
              <h5 style="font-size:.9rem;margin-bottom:3px">Global Clients</h5>
              <p style="font-size:.82rem;margin:0">US, Canada, and Europe. Async-first, timezone-friendly delivery.</p>
            </div>
          </div>
          <div style="padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:12px;display:flex;gap:14px;align-items:flex-start">
            <span style="font-size:1.5rem">&#128640;</span>
            <div>
              <h5 style="font-size:.9rem;margin-bottom:3px">50+ Projects Shipped</h5>
              <p style="font-size:.82rem;margin:0">From 2-week MVPs to multi-year product partnerships.</p>
            </div>
          </div>
          <div style="padding:20px;background:linear-gradient(135deg,rgba(108,71,255,.07),rgba(0,212,200,.04));border:1px solid rgba(108,71,255,.3);border-radius:12px;display:flex;gap:14px;align-items:flex-start">
            <span style="font-size:1.5rem">&#9889;</span>
            <div>
              <h5 style="font-size:.9rem;margin-bottom:3px;color:var(--accent-2)">AI-Enhanced Since 2024</h5>
              <p style="font-size:.82rem;margin:0">Cursor + Claude as standard tooling across all projects.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Stats -->
<section class="stats-section">
  <div class="dw-container">
    <div class="stats-row">
      <div class="stat-item reveal">
        <span class="stat-icon">&#128197;</span>
        <span class="stat-number stat-counter" data-target="5" data-suffix="+">5+</span>
        <span class="stat-label">Years in Business</span>
      </div>
      <div class="stat-item reveal reveal-d1">
        <span class="stat-icon">&#128640;</span>
        <span class="stat-number stat-counter" data-target="50" data-suffix="+">50+</span>
        <span class="stat-label">Projects Delivered</span>
      </div>
      <div class="stat-item reveal reveal-d2">
        <span class="stat-icon">&#127760;</span>
        <span class="stat-number stat-counter" data-target="20" data-suffix="+">20+</span>
        <span class="stat-label">Happy Clients</span>
      </div>
      <div class="stat-item reveal reveal-d3">
        <span class="stat-icon">&#127988;</span>
        <span class="stat-number stat-counter" data-target="4">4</span>
        <span class="stat-label">Countries Served</span>
      </div>
    </div>
  </div>
</section>

<!-- Why Us pillars -->
<section class="pillars-section dw-section">
  <div class="dw-container">
    <div class="text-center" style="margin-bottom:0">
      <span class="section-label reveal">Why Dadword IT</span>
      <h2 class="reveal reveal-d1">The four things that<br>set us apart.</h2>
    </div>

    <div class="pillars-full-grid">

      <div class="pillar-card-full reveal">
        <span class="pillar-num-label">01: Discovery</span>
        <h3>Deep Discovery First</h3>
        <p>
          We spend the first phase understanding your business model, your users,
          and your constraints before writing a line of code. This means fewer
          pivots, less rework, and a product that actually solves the right problem.
        </p>
      </div>

      <div class="pillar-card-full reveal reveal-d1">
        <span class="pillar-num-label">02: Collaboration</span>
        <h3>Async-first Collaboration</h3>
        <p>
          We work with clients in the US, Canada, and Europe, so we've built
          a culture of clear written communication, detailed weekly updates,
          and async-friendly processes that keep projects moving without
          requiring constant meetings.
        </p>
      </div>

      <div class="pillar-card-full reveal reveal-d2">
        <span class="pillar-num-label">03: Engineering</span>
        <h3>Senior-Only Engineering</h3>
        <p>
          Every project is handled end-to-end by senior engineers. No juniors
          learning on your budget. No account manager mediating between you and
          the dev team. You work directly with the people building your product.
        </p>
      </div>

      <div class="pillar-card-full ai-highlight reveal reveal-d3">
        <span class="pillar-num-label">04: Speed</span>
        <h3>AI-Enhanced Speed &#9889;</h3>
        <p>
          We use Cursor and Claude as daily engineering tools, not as a replacement
          for expertise, but as a force multiplier. Our senior engineers guide and
          review every output. The result: faster delivery cycles and lower total
          cost, without any compromise on code quality.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section dw-section">
  <div class="dw-container">
    <span class="section-label" style="justify-content:center">Work With Us</span>
    <h2 class="reveal">Ready to build something real?</h2>
    <p class="reveal reveal-d1">Start with a free 30-minute discovery call.</p>
    <div class="cta-btns reveal reveal-d2">
      <a href="/contact-us" class="btn-primary btn-lg">Start a Project</a>
      <a href="/lets-talk" class="btn-outline btn-lg">Book a Call</a>
    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: recent_blogs }) %>
<script src="/js/dadword.js" defer></script>
</body>
</html>
