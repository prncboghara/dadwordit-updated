<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title, meta, og, twitter, schema, canonical, trackingId}) %>
<body>

<!-- Preloader -->
<div id="dw-preloader">
  <div class="dw-preloader-bar"></div>
</div>

<!-- Navigation -->
<%- include('partials/header') %>

<!-- =========================================================
     HERO
     ========================================================= -->
<section class="hero-section">
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>

  <div class="dw-container">
    <div class="row align-items-center">

      <!-- Left: copy -->
      <div class="col-lg-6">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            Available for new projects
          </div>

          <h1 class="hero-title">
            We build <em>web portals</em> and Shopify products that scale.
          </h1>

          <p class="hero-sub">
            Senior-led team. AI-accelerated delivery. Custom code, no templates.
            For startups and product companies in the US, Canada, and Europe.
          </p>

          <div class="hero-ctas">
            <a href="/our-work" class="btn-outline btn-lg">See Our Work</a>
            <a href="/contact-us" class="btn-primary btn-lg">Start a Project</a>
          </div>

          <div class="hero-tags">
            <span class="hero-tag">&#9889; Shopify Partner</span>
            <span class="hero-tag">&#9679; Node.js</span>
            <span class="hero-tag">&#9679; React &amp; Next.js</span>
            <span class="hero-tag">&#9889; AI-Powered</span>
            <span class="hero-tag">&#9679; 5+ Years</span>
          </div>
        </div>
      </div>

      <!-- Right: terminal visual -->
      <div class="col-lg-6">
        <div class="hero-visual mt-5 mt-lg-0" style="position:relative">
          <!-- Floating badges -->
          <div class="floating-badge badge-a">
            <span style="width:8px;height:8px;border-radius:50%;background:#28c840;display:inline-block"></span>
            Shopify Partner
          </div>
          <div class="floating-badge badge-b">
            &#9889; AI-Enhanced Dev
          </div>
          <div class="floating-badge badge-c">
            &#10003; Senior Engineers Only
          </div>

          <div class="terminal-window">
            <div class="terminal-bar">
              <span class="terminal-dot td-red"></span>
              <span class="terminal-dot td-yellow"></span>
              <span class="terminal-dot td-green"></span>
              <span class="terminal-title">dadwordit ~ project-build</span>
            </div>
            <div class="terminal-body">
              <span class="t-line"><span class="t-comment"># Dadword IT &mdash; Stack v2.0</span></span>
              <span class="t-line">&nbsp;</span>
              <span class="t-line"><span class="t-prompt">$</span> <span class="t-cmd">npx create-dadword-app</span></span>
              <span class="t-line">&nbsp;</span>
              <span class="t-line"><span class="t-key">framework</span>  <span class="t-val">=&gt;</span> <span class="t-str">"<span id="t-rotating">Next.js</span>"</span></span>
              <span class="t-line"><span class="t-key">database</span>   <span class="t-val">=&gt;</span> <span class="t-str">"Prisma + Supabase"</span></span>
              <span class="t-line"><span class="t-key">ecommerce</span>  <span class="t-val">=&gt;</span> <span class="t-str">"Shopify API"</span></span>
              <span class="t-line"><span class="t-key">ai_assist</span>  <span class="t-val">=&gt;</span> <span class="t-str">"Cursor + Claude"</span></span>
              <span class="t-line">&nbsp;</span>
              <span class="t-line"><span class="t-prompt">$</span> <span class="t-cmd">npm run build &amp;&amp; deploy</span></span>
              <span class="t-line"><span class="t-str">&#10003; Production ready.</span></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- =========================================================
     SOCIAL PROOF — LOGO BAR
     ========================================================= -->
<section class="logos-section">
  <div class="dw-container">
    <p class="logos-label">Trusted by product teams &amp; startups across 4 countries</p>

    <div class="logos-marquee-wrap">
      <div class="logos-marquee">
        <!-- real clients (×2 for seamless loop) -->
        <% for(var i = 0; i < 2; i++) { %>
        <% clients.forEach(function(client) { %>
        <div class="logo-item">
          <img src="<%= client.image %>" alt="<%= client.alt %>" loading="lazy" />
        </div>
        <% }); %>
        <% } %>
      </div>
    </div>

    <div class="trust-badges">
      <span class="trust-badge"><span class="trust-badge-dot"></span> Shopify Partner</span>
      <span class="trust-badge"><span class="trust-badge-dot"></span> 5+ Years in Business</span>
      <span class="trust-badge"><span class="trust-badge-dot"></span> 50+ Projects Delivered</span>
      <span class="trust-badge"><span class="trust-badge-dot"></span> 4 Countries Served</span>
    </div>
  </div>
</section>

<!-- =========================================================
     SERVICES
     ========================================================= -->
<section class="services-section dw-section">
  <div class="dw-container">
    <div class="services-header">
      <span class="section-label reveal">What We Build</span>
      <h2 class="reveal reveal-d1">Specialist services,<br>not a generalist agency.</h2>
      <p class="section-sub reveal reveal-d2">
        We focus on a tight set of high-stakes services where senior experience and
        AI-enhanced speed give you a real competitive edge.
      </p>
    </div>

    <div class="services-grid">

      <!-- 1 -->
      <div class="service-card reveal reveal-d1">
        <div class="service-icon">&#127760;</div>
        <h3>Custom Web Portals</h3>
        <p>B2B SaaS dashboards, client portals, internal tools. Built with React or Next.js, designed for performance at scale.</p>
        <a href="/service" class="service-link">Learn More &rarr;</a>
      </div>

      <!-- 2 -->
      <div class="service-card reveal reveal-d2">
        <div class="service-icon">&#128722;</div>
        <h3>Shopify App Development</h3>
        <p>Custom Shopify apps, theme extensions, and Hydrogen storefronts that go beyond what the app store offers.</p>
        <a href="/service" class="service-link">Learn More &rarr;</a>
      </div>

      <!-- 3 -->
      <div class="service-card reveal reveal-d3">
        <div class="service-icon">&#128640;</div>
        <h3>SaaS Product Engineering</h3>
        <p>End-to-end product builds, from lean MVP to enterprise scale. Node.js, Prisma, Supabase, clean architecture.</p>
        <a href="/service" class="service-link">Learn More &rarr;</a>
      </div>

      <!-- 4 -->
      <div class="service-card service-card-featured reveal reveal-d1">
        <span class="service-badge">&#9889; New</span>
        <div class="service-icon">&#129302;</div>
        <h3>AI-Enhanced Development</h3>
        <p>We use Cursor + Claude in our daily engineering workflow, not as a shortcut, but as a force multiplier. Senior quality, faster timeline.</p>
        <a href="/service" class="service-link">Learn More &rarr;</a>
      </div>

      <!-- 5 -->
      <div class="service-card reveal reveal-d2">
        <div class="service-icon">&#128260;</div>
        <h3>Legacy Modernization</h3>
        <p>Redesign and re-architect aging codebases. Improve performance, security, and UX without starting from scratch.</p>
        <a href="/service" class="service-link">Learn More &rarr;</a>
      </div>

      <!-- 6 — mini CTA -->
      <div class="service-card reveal reveal-d3" style="display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(135deg,rgba(108,71,255,.08),rgba(0,212,200,.05))">
        <div>
          <p class="section-label" style="margin-bottom:12px">Not sure where to start?</p>
          <h3 style="font-size:1.2rem;margin-bottom:10px">Let's figure it out together.</h3>
          <p style="font-size:.88rem">Book a free 30-minute discovery call. No commitment, no sales pitch.</p>
        </div>
        <a href="/lets-talk" class="btn-primary" style="margin-top:20px;align-self:flex-start">Book a Free Call</a>
      </div>

    </div>
  </div>
</section>

<!-- =========================================================
     CUSTOMER STORY — FLAGSHIP PRODUCT
     ========================================================= -->
<section class="product-section dw-section" id="product">
  <div class="dw-container">
    <div class="row align-items-center g-5">

      <!-- Left: content -->
      <div class="col-lg-6">
        <div class="reveal">
          <span class="product-own-badge">&#9889; Our Own Product</span>
          <h2 class="product-title">
            Customer Story, our live<br><span class="text-gradient">Shopify app</span>
          </h2>
          <p class="product-desc">
            We don't just build products for clients. We build them for ourselves.
            Customer Story is a Shopify app for customer segmentation and lifecycle
            marketing, actively used by merchants worldwide.
          </p>

          <div class="product-metrics">
            <div>
              <span class="metric-num">10</span>
              <span class="metric-label">Early Installs</span>
            </div>
            <div>
              <span class="metric-num">5&#9733;</span>
              <span class="metric-label">Shopify Rating</span>
            </div>
            <div>
              <span class="metric-num">100%</span>
              <span class="metric-label">In-House Built</span>
            </div>
          </div>

          <div class="product-stack">
            <span class="stack-pill">Node.js</span>
            <span class="stack-pill">React</span>
            <span class="stack-pill">Shopify API</span>
            <span class="stack-pill">Prisma</span>
            <span class="stack-pill">Supabase</span>
            <span class="stack-pill">Polaris</span>
          </div>

          <div class="product-ctas">
            <a href="https://customersstory.com" target="_blank" rel="noopener" class="btn-primary">
              View on Shopify &rarr;
            </a>
            <a href="/portfolio/customer-story" class="btn-outline">Read Case Study</a>
          </div>
        </div>
      </div>

      <!-- Right: dashboard screenshot -->
      <div class="col-lg-6">
        <div class="product-mockup reveal reveal-d2">
          <div class="mockup-browser">
            <div class="mockup-topbar">
              <span class="mockup-dot" style="background:#ff5f57"></span>
              <span class="mockup-dot" style="background:#febc2e"></span>
              <span class="mockup-dot" style="background:#28c840"></span>
              <div class="mockup-url">customersstory.com/dashboard</div>
            </div>
            <img
              src="/images/result/customer-story-dashboard.webp"
              alt="Customer Story Shopify app dashboard"
              style="width:100%;display:block;border-radius:0 0 12px 12px"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- =========================================================
     CASE STUDIES
     ========================================================= -->
<section class="casestudies-section dw-section">
  <div class="dw-container">
    <span class="section-label reveal">Proven Results</span>
    <h2 class="reveal reveal-d1">Work that moved<br>the needle.</h2>
    <p class="section-sub reveal reveal-d2">
      We don't just deliver code. We solve real business problems and drive
      measurable growth for our clients.
    </p>

    <div class="case-list">
      <% caseStudies.forEach(function(item, index) { %>
      <div class="case-row <%= index % 2 !== 0 ? 'reverse' : '' %> reveal">

        <!-- Screenshot -->
        <a href="<%= item.link %>" target="_blank" rel="noopener" class="case-browser">
          <div class="case-browser-bar">
            <span style="background:#ff5f57"></span>
            <span style="background:#febc2e"></span>
            <span style="background:#28c840"></span>
          </div>
          <img src="<%= item.image %>" alt="<%= item.title %>" width="1200" height="661" loading="lazy" />
        </a>

        <!-- Content -->
        <div class="case-content">
          <span class="case-category"><%= item.category %></span>
          <h3 class="case-title"><%= item.title %></h3>

          <div class="case-block">
            <p class="case-block-label">Problem</p>
            <p class="case-block-text"><%= item.problem %></p>
          </div>

          <div class="case-block">
            <p class="case-block-label">Solution</p>
            <p class="case-block-text"><%= item.solution %></p>
          </div>

          <div class="case-block">
            <p class="case-block-label">Result</p>
            <p class="case-block-text case-result"><%= item.result %></p>
          </div>

          <a href="<%= item.link %>" target="_blank" rel="noopener" class="case-cta">
            View Live Project &rarr;
          </a>
        </div>

      </div>
      <% }); %>
    </div>

    <div style="text-align:center;margin-top:60px" class="reveal">
      <a href="/our-work" class="btn-outline btn-lg">See All Work</a>
    </div>
  </div>
</section>

<!-- =========================================================
     TESTIMONIALS
     ========================================================= -->
<section class="testimonials-section dw-section">
  <div class="dw-container">
    <div class="text-center" style="margin-bottom:0">
      <span class="section-label reveal">Client Testimonials</span>
      <h2 class="reveal reveal-d1">What our clients say.</h2>
      <p class="section-sub reveal reveal-d2 mx-auto">
        We measure success by the outcomes we create for the people we work with.
      </p>
    </div>

    <div class="testi-grid">
      <% testimonials.forEach(function(t, i) { %>
      <div class="testi-card reveal reveal-d<%= i + 1 %>">
        <div class="t-stars">
          <span class="t-star">&#9733;</span>
          <span class="t-star">&#9733;</span>
          <span class="t-star">&#9733;</span>
          <span class="t-star">&#9733;</span>
          <span class="t-star">&#9733;</span>
        </div>
        <p class="t-text">&ldquo;<%= t.text %>&rdquo;</p>
        <div class="t-author">
          <% if (t.image) { %>
          <img src="<%= t.image %>" alt="<%= t.name %>" class="t-avatar" loading="lazy" />
          <% } else { %>
          <div class="t-avatar-init"><%= t.name.charAt(0) %></div>
          <% } %>
          <div>
            <p class="t-name"><%= t.name %></p>
            <p class="t-role"><%= t.role %>, <%= t.location %></p>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- =========================================================
     STATS
     ========================================================= -->
<section class="stats-section">
  <div class="dw-container">
    <div class="stats-row">
      <div class="stat-item reveal">
        <span class="stat-icon">&#128197;</span>
        <span class="stat-number stat-counter" data-target="5" data-suffix="+">5+</span>
        <span class="stat-label">Years in Business</span>
      </div>
      <div class="stat-item reveal reveal-d1">
        <span class="stat-icon">&#128640;</span>
        <span class="stat-number stat-counter" data-target="50" data-suffix="+">50+</span>
        <span class="stat-label">Projects Delivered</span>
      </div>
      <div class="stat-item reveal reveal-d2">
        <span class="stat-icon">&#127760;</span>
        <span class="stat-number stat-counter" data-target="20" data-suffix="+">20+</span>
        <span class="stat-label">Happy Clients</span>
      </div>
      <div class="stat-item reveal reveal-d3">
        <span class="stat-icon">&#127988;</span>
        <span class="stat-number stat-counter" data-target="4">4</span>
        <span class="stat-label">Countries Served</span>
      </div>
      <div class="stat-item reveal reveal-d4">
        <span class="stat-icon">&#9889;</span>
        <span class="stat-number">AI</span>
        <span class="stat-label">Assisted Since 2024</span>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     ABOUT SNIPPET
     ========================================================= -->
<section class="about-snippet dw-section">
  <div class="dw-container">
    <div class="row align-items-center g-5">

      <!-- Left: copy -->
      <div class="col-lg-6">
        <div class="about-body">
          <span class="section-label reveal">About Dadword IT</span>
          <h2 class="reveal reveal-d1">Boutique agency.<br>Senior engineers.<br>AI-accelerated delivery.</h2>
          <p class="reveal reveal-d2">
            Dadword IT is a custom SaaS and web development agency helping startups
            and scale-ups in the US, Canada, and Europe turn ideas into reliable,
            scalable digital products.
          </p>
          <p class="reveal reveal-d2">
            Unlike typical agencies, we work as a product partner, aligning every
            technology decision with your business goals. No juniors on client work.
            No hand-holding needed.
          </p>
          <a href="/about" class="btn-outline reveal reveal-d3" style="margin-top:8px">About the Team &rarr;</a>
        </div>
      </div>

      <!-- Right: cards -->
      <div class="col-lg-6">
        <div class="about-cards-stack">
          <div class="about-mini-card reveal">
            <div class="about-mini-icon">&#128269;</div>
            <div>
              <h5>Deep Discovery</h5>
              <p>We spend time understanding your business before writing a single line of code.</p>
            </div>
          </div>
          <div class="about-mini-card reveal reveal-d1">
            <div class="about-mini-icon">&#128101;</div>
            <div>
              <h5>Senior-Only Engineering</h5>
              <p>Every project is handled by senior engineers. No juniors learning on your dime.</p>
            </div>
          </div>
          <div class="about-mini-card reveal reveal-d2">
            <div class="about-mini-icon">&#128203;</div>
            <div>
              <h5>Transparent Delivery</h5>
              <p>Weekly updates, clean documentation, and full code ownership handed to you at launch.</p>
            </div>
          </div>
          <div class="about-mini-card ai-mini-card reveal reveal-d3">
            <div class="about-mini-icon">&#9889;</div>
            <div>
              <h5>AI-Enhanced Speed</h5>
              <p>We use Cursor + Claude as engineering force multipliers. Same quality, fewer calendar weeks.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- =========================================================
     CTA BANNER
     ========================================================= -->
<section class="cta-section dw-section">
  <div class="dw-container">
    <span class="section-label" style="justify-content:center">Ready to Build?</span>
    <h2 class="reveal">Let's turn your idea<br>into a real product.</h2>
    <p class="reveal reveal-d1">
      We respond to all enquiries within 24 hours.
      No commitment required for the first call.
    </p>
    <div class="cta-btns reveal reveal-d2">
      <a href="/contact-us" class="btn-primary btn-lg">Start a Project</a>
      <a href="/lets-talk" class="btn-outline btn-lg">Book a Discovery Call</a>
    </div>
  </div>
</section>

<!-- =========================================================
     CONTACT FORM
     ========================================================= -->
<section class="contact-section dw-section">
  <div class="dw-container">
    <div class="contact-grid">
      <div class="contact-info">
        <span class="section-label">Get in Touch</span>
        <h2>Tell us about<br>your project.</h2>
        <p class="section-sub">
          We'll review your message and get back to you with a plan, usually within one business day.
        </p>

        <div class="contact-details" style="margin-top:32px">
          <div class="cdetail">
            <div class="cdetail-icon acc">&#9993;</div>
            <div>
              <span class="cdetail-lbl">Email</span>
              <p class="cdetail-val"><a href="mailto:contact@dadwordit.com">contact@dadwordit.com</a></p>
            </div>
          </div>
          <div class="cdetail">
            <div class="cdetail-icon">&#128205;</div>
            <div>
              <span class="cdetail-lbl">Office</span>
              <p class="cdetail-val">Rajkot, Gujarat, India</p>
            </div>
          </div>
          <div class="cdetail">
            <div class="cdetail-icon">&#9200;</div>
            <div>
              <span class="cdetail-lbl">Response Time</span>
              <p class="cdetail-val">Within 24 hours, Monday to Saturday</p>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/form') %>
    </div>
  </div>
</section>

<!-- Footer -->
<%- include('partials/footer', { recent_blogs: recent_blogs }) %>

<!-- Scripts -->
<script src="/js/dadword.js" defer></script>

</body>
</html>
