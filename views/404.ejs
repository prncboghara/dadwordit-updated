<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Page Not Found | Dadword IT</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/syne-700.woff2" as="font" type="font/woff2" crossorigin>
  <link href="/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/dadword.css" rel="stylesheet">
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
<%- include('partials/header') %>

<section style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:160px 24px 80px;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%,rgba(108,71,255,.1) 0%,transparent 60%)"></div>
  <div style="position:relative;z-index:1">
    <div style="font-family:var(--font-display);font-size:clamp(5rem,15vw,10rem);font-weight:800;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:24px">404</div>
    <h1 style="font-size:clamp(1.4rem,3vw,2rem);margin-bottom:14px">Page not found.</h1>
    <p style="max-width:400px;margin:0 auto 36px;font-size:1rem">The page you're looking for doesn't exist or may have been moved.</p>
    <div style="display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap">
      <a href="/" class="btn-primary btn-lg">Go Home</a>
      <a href="/our-work" class="btn-outline btn-lg">See Our Work</a>
    </div>
  </div>
</section>

<%- include('partials/footer', { recent_blogs: [] }) %>
<script src="/js/dadword.js" defer></script>
</body>
</html>
